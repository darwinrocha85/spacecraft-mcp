# Copiá este archivo a .env (y opcionalmente .env.local para overrides de solo tu máquina)
# dentro de esta misma carpeta (spacecraft-mcp/functions/).

# "gemini" o "claude"
AI_PROVIDER=gemini

# Necesaria si AI_PROVIDER=gemini
GEMINI_API_KEY=

# Necesaria si AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Opcional: fuerza un modelo puntual (si no, usa el default de ai-provider.js)
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Etiqueta cada documento de uso (colección `ai_usage` en Firestore) como pre/post-harness
# para comparar consumo (tokens, latencia, borradores resueltos sin LLM) antes y después del
# harness. Cambiar a "post-harness" el día que exista, sin tocar código.
HARNESS_PHASE=pre-harness

# URLs de los backends (prod: fallback en código a Render si no se definen)
NAVESPACE_API_BASE=http://localhost:8080/api
TALLER_API_BASE=http://localhost:8001/api
